# Postgres
POSTGRES_USR="your_postgres_user"
POSTGRES_PWD="your_postgres_password"
POSTGRES_DB="your_database_name"
POSTGRES_URL="postgres://${POSTGRES_USR}:${POSTGRES_PWD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"

# Traefik
CF_DNS_API_TOKEN="your_cloudflare_token"
ACME_EMAIL="your_email@example.com"
DOMAIN="yourdomain.com"

# Postgres Exporter
PE_POSTGRES_URI="your_endpoint:5432"
PE_POSTGRES_USERNAME="postgres_exporter_user"
PE_POSTGRES_PASSWORD="postgres_exporter_password"

# Prometheus
PROMETHEUS_SUBDOMAIN="prometheus"

# Grafana
GRAFANA_SUBDOMAIN="grafana"

# Monitoring (read-only DB user)
MONITORING_DB_USERNAME="monitoring_user"
MONITORING_DB_PASSWORD="monitoring_password"

# pgbench (the docs assume these exact names, more info on the README)
PGBENCH_DB_USERNAME="app"
PGBENCH_DB_PASSWORD="app"
PGBENCH_DB_NAME="lab"

# Optional: token of a grafana service account so incidents post annotations
# GRAFANA_TOKEN="glsa_..."
